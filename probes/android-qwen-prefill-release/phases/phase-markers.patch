+  ~W3AudioTrace() {
+    __android_log_print(
+        ANDROID_LOG_INFO, "W3Phase",
+        "v1 group=audio pid=%d tid=%d ns=%lld,%lld,%lld,%lld",
+        static_cast<int>(getpid()), static_cast<int>(gettid()),
+        static_cast<long long>(conv_begin), static_cast<long long>(conv_end),
+        static_cast<long long>(encoder_begin),
+        static_cast<long long>(encoder_end));
+  }
+};
